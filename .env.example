# ============================================================
# PM-RAG - Configuration
# Copy this file to ".env" and adjust as needed.
# All values have safe defaults so the app runs out-of-the-box.
# ============================================================

# ---- Application ----
APP_NAME=PM-RAG
APP_ENV=development
LOG_LEVEL=INFO

# ---- Paths (absolute paths recommended on Windows) ----
# Default dataset directory (the three NYC CSV files live here).
DATASET_DIR=D:\Website\Journal_Research\PM-RAG\dataset
# Local app storage (vector index, uploads, logs, exports).
STORAGE_DIR=storage
# Supplementary knowledge documents (PDF/TXT/MD lessons-learned, guidance).
KNOWLEDGE_DIR=knowledge
# Research result exports.
REPORTS_DIR=reports

# ---- Database -----------------------------------------------
# DB_BACKEND: sqlite | mysql | postgresql
# Default is sqlite so the platform runs with zero external services.
# To use MySQL (per research spec) set DB_BACKEND=mysql and fill the fields.
DB_BACKEND=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pm_rag
DB_USER=root
DB_PASSWORD=
# Optional explicit SQLAlchemy URL; if set it overrides the fields above.
# Example MySQL: mysql+pymysql://root:@localhost:3306/pm_rag
# Example Postgres: postgresql+psycopg2://postgres:pass@localhost:5432/pm_rag
# DATABASE_URL=

# ---- Vector store (ChromaDB persistent, with numpy fallback) ----
CHROMA_DIR=storage/chroma
COLLECTION_NAME=pm_rag_evidence

# ---- Embeddings ----
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# If sentence-transformers / torch are unavailable, a deterministic hashing
# embedder is used automatically so ingestion/retrieval still work offline.
EMBED_FALLBACK_DIM=384

# ---- Chunking ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---- Retrieval ----
TOP_K=8
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RRF_K=60
SIMILARITY_THRESHOLD=0.15

# ---- Reranking ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ---- LLM / SLM ----
# Backend: huggingface | openai | ollama | stub
# "stub" uses an evidence-only extractive generator (no model download, cannot
# hallucinate) and is the auto-fallback if a real model cannot load.
LLM_BACKEND=huggingface
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=4096
LOAD_IN_4BIT=false

# OpenAI-compatible endpoint (only used when LLM_BACKEND=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (only used when LLM_BACKEND=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face token (for gated models)
# HF_TOKEN=

# ---- NLI grounding ----
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_ENABLED=true

# ---- Abstention ----
MIN_EVIDENCE_FOR_ANSWER=1
ABSTENTION_GROUNDING_THRESHOLD=0.5
